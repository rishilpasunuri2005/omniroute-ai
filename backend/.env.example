ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://omniroute:omniroute@postgres:5432/omniroute
AUTH_REQUIRED=true
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=OmniRoute AI
SIMPLE_MODEL=llama-3.1-8b-instant
BALANCED_MODEL=llama-3.3-70b-versatile
CODING_MODEL=deepseek/deepseek-coder
REASONING_MODEL=deepseek/deepseek-r1
FALLBACK_MODEL=openai/gpt-oss-20b
ROUTE_CONFIDENCE_THRESHOLD=0.62
MAX_RETRIES=2
MAX_REQUEST_BYTES=512000
PER_USER_DAILY_TOKEN_BUDGET=100000
SENTRY_DSN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omniroute-ai
